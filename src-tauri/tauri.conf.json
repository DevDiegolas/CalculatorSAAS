{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalcPay",
  "version": "0.1.1",
  "identifier": "com.calcpay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:47291",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CalcPay",
        "width": 940,
        "height": 820,
        "minWidth": 940,
        "minHeight": 820,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
